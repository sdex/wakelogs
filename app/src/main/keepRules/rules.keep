# Shizuku instantiates the user service reflectively in its own process.
-keep class de.sanniki.wakesleuth.WakeSleuthUserService {
    <init>(...);
}

# AIDL interface and its Stub/Proxy are resolved by the binder framework.
-keep class de.sanniki.wakesleuth.IWakeSleuthShell { *; }
-keep class de.sanniki.wakesleuth.IWakeSleuthShell$Stub { *; }
-keep class de.sanniki.wakesleuth.IWakeSleuthShell$Stub$Proxy { *; }

# Readable crash reports.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

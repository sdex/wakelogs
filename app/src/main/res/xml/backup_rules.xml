<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup

   The event database holds device specific diagnostics of this phone
   only; restoring it on another device would be misleading and could
   resurrect a session that looks as if it were still running.
-->
<full-backup-content>
    <exclude domain="database" path="wakelogs.db" />
    <exclude domain="database" path="wakelogs.db-wal" />
    <exclude domain="database" path="wakelogs.db-shm" />
    <exclude domain="database" path="wakelogs.db-journal" />
</full-backup-content>

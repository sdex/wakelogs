<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The event database holds device specific diagnostics and is excluded
   from both cloud backup and device transfer (see backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="wakelogs.db" />
        <exclude domain="database" path="wakelogs.db-wal" />
        <exclude domain="database" path="wakelogs.db-shm" />
        <exclude domain="database" path="wakelogs.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="wakelogs.db" />
        <exclude domain="database" path="wakelogs.db-wal" />
        <exclude domain="database" path="wakelogs.db-shm" />
        <exclude domain="database" path="wakelogs.db-journal" />
    </device-transfer>
</data-extraction-rules>
